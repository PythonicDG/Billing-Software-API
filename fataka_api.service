[Unit]
Description=Gunicorn Service for Vighnaharta Fataka API
Requires=fataka_api.socket
After=network.target

[Service]
# --- User & Group ---
# The Unix user and group under which the Gunicorn server runs.
# 'www-data' is the standard web-server user on Ubuntu/Debian, ensuring
# proper read/write permissions to static files and sockets.
# (If you cloned the repo in '/home/ubuntu/', you can change this to 'User=ubuntu')
User=ubuntu
Group=www-data

# --- Application Paths ---
# The absolute path to the directory containing 'manage.py'
WorkingDirectory=/home/ubuntu/fataka_app/Billing-Software-API

# --- Execution Command ---
# Triggers Gunicorn inside your virtual environment, using your custom configuration file.
ExecStart=/home/ubuntu/fataka_app/Billing-Software-API/venv/bin/gunicorn \
          -c /home/ubuntu/fataka_app/Billing-Software-API/fataka_gunicorn.conf.py \
          billing_api.wsgi:application

# --- Process Lifecycles ---
Restart=always
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fataka_api

[Install]
WantedBy=multi-user.target
