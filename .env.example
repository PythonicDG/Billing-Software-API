# ==============================================================================
# Django Production Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and populate with your production values.
# DO NOT commit the actual '.env' file containing real passwords to Git.
# ==============================================================================

# --- Django Core Settings ---
# Set a unique, high-entropy secret key for production (e.g., generated with 'openssl rand -hex 32')
SECRET_KEY=django-secure-production-random-secret-key-here-change-me

# Enforce strict production mode by setting DEBUG to False
DEBUG=False

# Comma-separated list of domain names and IP addresses Django can serve
# Example: ALLOWED_HOSTS=api.vighnahartafataka.com,123.456.78.90,localhost,127.0.0.1
ALLOWED_HOSTS=api.vighnahartafataka.com,localhost,127.0.0.1


# --- Database Connection ---
# Primary production database URL (PostgreSQL recommended)
# Format: postgres://username:password@hostname:port/database_name
# Example: DATABASE_URL=postgres://vighnaharta_prod:securepwd123@prod-db.c12345.us-east-1.rds.amazonaws.com:5432/vighnaharta_db
DATABASE_URL=postgres://vighnaharta_user:vighnaharta_password@localhost:5432/vighnaharta_prod

# Fallbacks if DATABASE_URL is not used (Optional)
DB_NAME=vighnaharta_prod
DB_USER=vighnaharta_user
DB_PASSWORD=vighnaharta_password
DB_HOST=localhost
DB_PORT=5432


# --- Security & SSL Settings ---
# Force HTTPS redirects and secure cookies (Set to True in production)
SECURE_SSL=True


# --- CORS (Cross-Origin Resource Sharing) Settings ---
# Set to False in production to only allow whitelisted domains to call your API
CORS_ALLOW_ALL_ORIGINS=False

# Comma-separated list of frontend domains allowed to make cross-origin REST requests
# Example: CORS_ALLOWED_ORIGINS=https://vighnahartafataka.com,https://admin.vighnahartafataka.com
CORS_ALLOWED_ORIGINS=https://vighnahartafataka.com,http://localhost:3000


# --- CSRF (Cross-Site Request Forgery) Settings ---
# Comma-separated list of origins trusted to send POST/PUT requests
# Example: CSRF_TRUSTED_ORIGINS=https://vighnahartafataka.com,https://api.vighnahartafataka.com
CSRF_TRUSTED_ORIGINS=https://vighnahartafataka.com,https://api.vighnahartafataka.com
